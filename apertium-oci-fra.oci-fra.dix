    <!-- aquest paradigma és pro forma perquè la traducció pugui competir per longitud amb altres traduccions possibles -->
    <pardef n="sp_sp">
      <e>       <p><l><s n="sg"/></l><r><s n="sg"/></r></p></e>
      <e>       <p><l><s n="pl"/></l><r><s n="pl"/></r></p></e>
    </pardef>

