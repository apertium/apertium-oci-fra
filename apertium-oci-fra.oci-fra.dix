    <sdef n="dat2nom" c="datif > nominatif (me dòl > j'ai mal à) ; ces verbes doivent être aussi introduits dans apertium-oci-fra.oci-fra.t1x dans les catégories verb_dat2nom_* (dans apertium-oci-fra.oci-fra.t1x pour les lignes qui génèrent des verbes non pronominaux en français, et dans apertium-oci-fra.fra-oci.t1x pour celles qui génèrent des verbes occitans)"/>
    <sdef n="nom2dat" c="nominatif > datif (j'ai mal à > me dòl)"/>
    <sdef n="pron" c="générer un verbe pronominal (si le verbe d'origine ne l'est pas)"/>
    <sdef n="nopron" c="pour différencier les cas où il faut faire un sélection lexique entre un verbe pronominal et le même verbe (lemme) non-pronominal"/>
    <sdef n="non-pron" c="générer un verbe non pronominal si le verbe d'origine est pronominal (s'enlaira > décole) ; ces verbes doivent être aussi introduits dans apertium-oci-fra.*.t1x dans les catégories verb_pron-nopron_* (dans apertium-oci-fra.oci-fra.t1x pour les lignes qui génèrent des verbes non pronominaux en français, et dans apertium-oci-fra.fra-oci.t1x pour celles qui génèrent des verbes occitans)"/>
