    </pardef>

    <pardef n="f_h"> <!-- funciona pas -->
      <e alt="oci">                <p><l>f</l><r></r></p></e>
      <e r="LR" alt="oci@gascon">  <p><l>f</l><r></r></p></e>
      <e r="LR" alt="oci@aran">    <p><l>f</l><r></r></p></e>
      <e r="LR" alt="oci">         <p><l>h</l><r></r></p></e>
      <e alt="oci@gascon">         <p><l>h</l><r></r></p></e>
      <e alt="oci@aran">           <p><l>h</l><r></r></p></e>
    </pardef>

    <pardef n="v-v_tv">
      <!-- tradusir vblex a vblex.tv de l'occitan al francés e vblex a vblex.tv del francés a l'occitan;
           l'etiqueta tv s'elimina en lo transfer. -->
      <!-- l'etiqueta s'utiliza pel tractament dels partitius: je veux du pain <> vòli de pan -->
      <e r="LR"><p><l></l><r><s n="tv"/></r></p></e>
      <e r="RL"><p><l><s n="tv"/></l><r></r></p></e>
    </pardef>

    <pardef n="dat2nom">
      <!-- ajout d'étiquettes pour signaler la transformation d'une construction dative en occitan à une nominale en français
           et vice-versa:
           me dòl lo braç <> j'ai mal au braç -->
      <!-- (ces verbes doivent être aussi introduits dans apertium-oci-fra.oci-fra.t1x dans les catégories verb_dat2nom_*) -->
      <e r="LR"><p><l></l><r><s n="dat2nom"/></r></p></e>
      <e r="RL"><p><l><s n="nom2dat"/></l><r></r></p></e>
    </pardef>

    <pardef n="pas_neg">
      <!-- étiquette à ajouter aux paires d'adverbes et pronoms pour lesquels on a besoin de 'pas' en occitan, mais pas en français:
         n'i vau pas jamei <> je n'y vais jamais ; i pensi pas pus <> je n'y pense plus -->
      <e r="LR"><p><l></l><r><s n="pas_neg"/></r></p></e>
      <e r="RL"><p><l><s n="pas_neg"/></l><r></r></p></e>
    </pardef>

   </pardefs>

